# Other agent sessions check out worktrees here; they are clones, not content.
.claude/worktrees/

# Python bytecode from running scripts/test_remote_snapshot_probe.py locally.
__pycache__/

# The local design-parity working directory: the materialised reference cache
# (`git archive design-parity/reference` — ~84 MB of kit PNGs), the pinned
# compose-preview CLI the candidate is packed with (~213 MB under cli/<version>/)
# and the per-run report.html output. All three are reproducible from the
# delivery branches and the release, and they are large enough that one
# `git add -A` after a local parity run would put them in the history for good.
# See docs/PARITY_LOCAL.md.
.design-parity/
