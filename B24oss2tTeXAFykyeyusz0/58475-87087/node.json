  "styles": {
    "47942:129509": {
      "key": "50d1d0739944559cc3ae020aba97c314b3c8acc1",
      "name": "title/med",
      "styleType": "TEXT",
      "remote": false,
      "description": "Title Medium is the medium title. \n\nTitles are smaller than Displays. They are typically reserved for medium-emphasis text that is shorter in length and not recommended for interactive components, rather page headings or sub headings."
    },
    "47942:129515": {
      "key": "0c992398f56b1fd9ae0fa99f2615a0fdb07f4d8e",
      "name": "body/med",
      "styleType": "TEXT",
      "remote": false,
      "description": "Body Medium is second largest body. \n\nBody texts are typically used for long-form writing as it works well for small text sizes. For longer sections of text, a serif or sans serif typeface is recommended."
    }
  },
