            "remote-m3/capturing-wear-widget-preview": {
                "record": "remote-catalog/ee.schimke.wearm3catalog.remote.WidgetContainerPreviewsKt.CapturingWearWidgetPreview",
                "catalogId": null,
                "displayName": null,
                "canvas": null,
                "nativeOnly": false,
                "traits": [],
                "slots": {},
                "stateCallbacks": {},
                "starter": {},
                "variantProperty": null,
                "variants": {},
