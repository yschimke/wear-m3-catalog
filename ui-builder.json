{
    "schema": "compose-ui-builder-catalog/v1",
    "catalog": {
        "id": "remote-m3",
        "title": "Remote Compose Material 3",
        "platform": "remote-compose",
        "platformLabel": "RemoteCompose",
        "module": "remote-catalog",
        "variant": "debug"
    },
    "record": {
        "file": "components.json",
        "schemaVersion": 2,
        "components": 28
    },
    "statusSemantics": {
        "platform": "remote-compose",
        "platformLabel": "RemoteCompose",
        "componentIdPrefix": "remote-m3/",
        "previewSurfaces": {
            "wasm": {
                "fidelity": "approximate",
                "reason": "A Remote Compose document is played, not composed. The builder's Wasm canvas has no player, so it draws the widget host frame and placeholders inside it; what the player would draw is a different picture, produced by a different program from the same document."
            },
            "native": {
                "fidelity": "authoritative",
                "backend": "android",
                "reason": "The generated creation-DSL Kotlin compiled against this module's own alpha Remote Compose trio and rasterised by the real player — the same lane that produces every sticker in this catalog."
            }
        },
